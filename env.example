# ============================================================================
# Configuración del Sistema FTP Distribuido
# Copia este archivo a .env y ajusta los valores según tu entorno
# ============================================================================

# IP pública del servidor (usada para modo PASV)
# Dejar vacío para autodetección
PUBLIC_IP=

# Credenciales del administrador inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Nombre del stack en Docker Swarm
STACK_NAME=ftp-cluster


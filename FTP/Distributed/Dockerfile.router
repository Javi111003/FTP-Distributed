# Dockerfile para el servicio Router (FTP Frontend)
FROM python:3.11-slim

WORKDIR /app

# Copiar código
COPY FTP /app/FTP

# Instalar dependencias
COPY FTP/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Asegurar que los paquetes se reconozcan como módulos
RUN touch /app/FTP/__init__.py && \
    touch /app/FTP/Distributed/__init__.py && \
    touch /app/FTP/Distributed/Common/__init__.py && \
    touch /app/FTP/Distributed/Router/__init__.py

# Puerto FTP y rango de puertos PASV
EXPOSE 21
EXPOSE 30000-30100

# Variables de entorno por defecto
ENV PYTHONUNBUFFERED=1
ENV NODE_TYPE=router

# Comando de inicio
CMD ["python", "-u", "-m", "FTP.Distributed.Router.router_server"]

